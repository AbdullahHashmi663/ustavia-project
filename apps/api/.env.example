DATABASE_URL=postgresql://ustavia:ustavia@localhost:5432/ustavia
# For Supabase: use the Session Pooler connection string, not the direct db.<ref>.supabase.co
# host — the direct host is IPv6-only on projects without the IPv4 add-on, which many
# networks/containers can't reach. Find it in the dashboard: Connect -> Session pooler.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set DATABASE_SSL=true whenever DATABASE_URL points at a hosted Postgres that requires TLS
# (Supabase, in both direct and pooler form, does).
DATABASE_SSL=false
# Only needed if a module talks to Supabase directly (storage, auth, realtime) rather than
# through TypeORM's DATABASE_URL connection. SUPABASE_PUBLISHABLE_KEY is the public/anon key —
# safe to ship to clients — never put a Supabase *secret* key in a client-shipped env var.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SMS_PROVIDER_API_KEY=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
RAAST_API_KEY=
RAAST_MERCHANT_ID=
ONELINK_API_KEY=
FBR_WITHHOLDING_RATE=0
FCM_SERVER_KEY=
PLATFORM_CUT_PERCENTAGE=10
PORT=3000
